---
import BrandMark from "@/components/BrandMark.astro";
import ArchitectureShowcase from "@/components/sections/ArchitectureShowcase.astro";
import FooterCta from "@/components/sections/FooterCta.astro";
import HeroStage from "@/components/sections/HeroStage.astro";
import IntegrationsTicker from "@/components/sections/IntegrationsTicker.astro";
import LandingHeader from "@/components/sections/LandingHeader.astro";
import {
  docsUrl,
  getSiteContent,
  githubUrl,
  homepageUrl,
  localeHref,
  localeLabels,
  type Locale,
} from "@/content/site";
import LandingLayout from "@/layouts/LandingLayout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getSiteContent(locale);
---

<LandingLayout description={content.meta.description} lang={locale} title={content.meta.title}>
  <div
    class="relative isolate min-h-dvh overflow-hidden selection:bg-primary/25 selection:text-foreground"
    data-copy-error-label={content.install.copyFailedLabel}
    data-copy-success-label={content.install.copiedLabel}
  >
    <LandingHeader
      brand={content.brand}
      currentLocale={locale}
      docsLabel={content.navigation.docsLabel}
      docsUrl={docsUrl}
      githubLabel={content.navigation.githubLabel}
      githubUrl={githubUrl}
      homepageUrl={homepageUrl}
      languageLabel={content.navigation.languageLabel}
      localeHref={localeHref}
      localeLabels={localeLabels}
    />

    <main id="top">
      <HeroStage content={content} docsUrl={docsUrl} />
      <ArchitectureShowcase content={content} />
      <IntegrationsTicker content={content.integrations} />
      <FooterCta content={content} docsUrl={docsUrl} />
    </main>

    <footer class="relative z-10 mt-auto border-t border-border/80">
      <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-8 md:flex-row md:items-center md:justify-between">
        <BrandMark compact eyebrow={content.brand.eyebrow} homeHref={homepageUrl} name={content.brand.footerName} />
        <div class="text-center text-sm text-muted-foreground md:text-right">
          <p class="mx-auto max-w-[38rem] text-pretty leading-6 md:ml-auto">{content.footer.summary}</p>
          <div class="mt-3 flex flex-wrap items-center justify-center gap-2 md:justify-end">
            <a class="inline-flex min-h-10 items-center rounded-full px-3 py-2 font-medium text-foreground transition-colors hover:bg-white/70 hover:text-primary-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" href={docsUrl}>{content.footer.docsLabel}</a>
            <a class="inline-flex min-h-10 items-center rounded-full px-3 py-2 transition-colors hover:bg-white/70 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" href={homepageUrl}>chainbot.dev</a>
            <a class="inline-flex min-h-10 items-center rounded-full px-3 py-2 transition-colors hover:bg-white/70 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40" href={githubUrl}>{content.footer.githubLabel}</a>
          </div>
          <p class="mt-3 text-xs uppercase tracking-[0.2em] text-muted-foreground/80">{content.brand.footerCopyright}</p>
        </div>
      </div>
    </footer>

    <p aria-live="polite" class="sr-only" data-copy-status role="status"></p>

    <script is:inline>
      const copyButtons = Array.from(document.querySelectorAll("[data-copy-text]"));
      const root = document.querySelector("[data-copy-success-label]");
      const statusNode = document.querySelector("[data-copy-status]");
      const copiedLabel = root?.getAttribute("data-copy-success-label") ?? "Copied";
      const copyFailedLabel = root?.getAttribute("data-copy-error-label") ?? "Copy failed";

      for (const button of copyButtons) {
        if (!(button instanceof HTMLButtonElement)) continue;

        const originalLabel = button.getAttribute("aria-label") ?? "Copy";

        button.addEventListener("click", async () => {
          const copyText = button.dataset.copyText;
          if (!copyText) return;

          try {
            await navigator.clipboard.writeText(copyText);
            button.setAttribute("aria-label", copiedLabel);
            button.dataset.copied = "true";
            if (statusNode instanceof HTMLElement) {
              statusNode.textContent = copiedLabel;
            }
            window.setTimeout(() => {
              button.setAttribute("aria-label", originalLabel);
              delete button.dataset.copied;
            }, 1600);
          } catch {
            button.setAttribute("aria-label", copyFailedLabel);
            if (statusNode instanceof HTMLElement) {
              statusNode.textContent = copyFailedLabel;
            }
            window.setTimeout(() => {
              button.setAttribute("aria-label", originalLabel);
            }, 1600);
          }
        });
      }
    </script>
  </div>
</LandingLayout>
