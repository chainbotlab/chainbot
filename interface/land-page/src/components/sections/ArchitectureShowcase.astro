---
import type { ArchitectureStepTone, SiteContent } from "@/content/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;

const toneClasses: Record<ArchitectureStepTone, string> = {
  base: "border-border bg-white text-foreground",
  accent: "border-primary/20 bg-primary-subtle text-primary-ink",
  ink: "border-foreground bg-foreground text-white",
};

const markerClasses: Record<ArchitectureStepTone, string> = {
  base: "border-border bg-white text-muted-foreground",
  accent: "border-primary/20 bg-primary-soft text-primary-strong",
  ink: "border-white/15 bg-foreground text-white",
};

const bodyClasses: Record<ArchitectureStepTone, string> = {
  base: "text-muted-foreground",
  accent: "text-primary-ink/80",
  ink: "text-white/65",
};
---

<section class="section-deferred relative z-10 mx-auto w-full max-w-7xl px-6 py-12">
  <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-16">
    <div class="flex flex-col justify-center lg:w-[22rem]">
      <div class="type-eyebrow mb-4 text-muted-foreground">{content.architecture.eyebrow}</div>
      <h3 class="type-section-title mb-6 max-w-md text-foreground">{content.architecture.title}</h3>
      <p class="type-section-body mb-8 max-w-[34rem] text-pretty text-muted-foreground">{content.architecture.description}</p>
    </div>

    <div class="lg:flex-1">
      <div class="space-y-4">
        {content.architecture.steps.map((step) => (
          <article class:list={["grid grid-cols-[auto_minmax(0,1fr)] items-start gap-5 rounded-[1.5rem] border px-5 py-5 transition-colors sm:px-6", toneClasses[step.tone]]}>
            <div class:list={["flex size-10 items-center justify-center rounded-full border font-display text-sm font-bold", markerClasses[step.tone]]}>
              {step.id}
            </div>
            <div class="flex-1">
              <h4 class="mb-2 font-display text-[1.25rem] font-medium tracking-[-0.02em]">{step.title}</h4>
              <p class:list={["type-caption", bodyClasses[step.tone]]}>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
