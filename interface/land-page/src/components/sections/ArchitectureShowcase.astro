---
import type { ArchitectureStepTone, SiteContent } from "@/content/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;

const toneClasses: Record<ArchitectureStepTone, string> = {
  base: "border-border bg-white text-foreground",
  accent: "border-primary/20 bg-primary-subtle text-primary-ink",
  ink: "border-foreground bg-foreground text-white",
};

const markerClasses: Record<ArchitectureStepTone, string> = {
  base: "border-border bg-white text-muted-foreground",
  accent: "border-primary/20 bg-primary-soft text-primary-strong",
  ink: "border-white/15 bg-foreground text-white",
};

const bodyClasses: Record<ArchitectureStepTone, string> = {
  base: "text-muted-foreground",
  accent: "text-primary-ink/80",
  ink: "text-white/65",
};
---

<section class="relative z-10 mx-auto w-full max-w-7xl px-6 py-12">
  <div class="flex flex-col gap-16 rounded-[2.5rem] border border-border bg-surface p-10 shadow-sm lg:flex-row lg:p-14">
    <div class="flex flex-col justify-center lg:w-1/3">
      <div class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground">{content.architecture.eyebrow}</div>
      <h3 class="mb-6 max-w-md font-display text-4xl leading-tight text-foreground">{content.architecture.title}</h3>
      <p class="mb-8 max-w-md text-pretty leading-relaxed text-muted-foreground">{content.architecture.description}</p>

      <div class="flex flex-wrap gap-2">
        {content.architecture.tags.map((tag) => (
          <span class="rounded-full border border-border bg-white px-4 py-2 text-xs font-medium text-foreground shadow-sm">{tag}</span>
        ))}
      </div>
    </div>

    <div class="relative rounded-[2rem] border border-border/60 bg-background px-8 py-8 lg:w-2/3">
      <div aria-hidden="true" class="absolute bottom-20 left-16 top-20 -z-0 hidden w-px border-l-2 border-dashed border-border-dark lg:block"></div>

      <div class="relative z-10 space-y-6">
        {content.architecture.steps.map((step) => (
          <article class:list={["relative ml-8 flex gap-6 rounded-2xl border p-6 shadow-sm transition-transform hover:-translate-y-1 hover:shadow-md", toneClasses[step.tone]]}>
            <div class:list={["absolute -left-[4.5rem] top-1/2 flex size-10 -translate-y-1/2 items-center justify-center rounded-full border-2 font-display text-sm font-bold shadow-sm", markerClasses[step.tone]]}>
              {step.id}
            </div>
            <div class="flex-1">
              <h4 class="mb-2 font-display text-xl font-medium">{step.title}</h4>
              <p class:list={["text-sm leading-relaxed", bodyClasses[step.tone]]}>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
