---
import type { IntegrationsContent } from "@/content/site";
import { BrandMarquee } from "@/components/sections/BrandMarquee";

interface Props {
  content: IntegrationsContent;
}

const { content } = Astro.props;
---

<section class="section-deferred relative border-y border-border/60 bg-white/35 py-6">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-5 text-center">
      <p class="type-eyebrow text-primary-strong/80">{content.eyebrow}</p>
      <h2 class="mt-2 font-display text-[2rem] leading-[1.08] tracking-[-0.03em] text-foreground sm:text-[2.4rem]">{content.title}</h2>
    </div>

    <BrandMarquee ariaLabel={content.ariaLabel} items={content.items} />
  </div>
</section>
