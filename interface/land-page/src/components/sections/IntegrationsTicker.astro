---
import type { IntegrationItem } from "@/content/site";
import { BrandMarquee } from "@/components/sections/BrandMarquee";

interface Props {
  items: IntegrationItem[];
}

const { items } = Astro.props;
---

<section class="relative border-y border-border/60 bg-white/35 py-6 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-5 flex flex-col gap-2 text-center lg:flex-row lg:items-end lg:justify-between lg:text-left">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-primary-strong/80">Built for AI-native operators</p>
        <h2 class="mt-2 font-display text-3xl text-foreground sm:text-4xl">Moves with the agent tooling you already trust.</h2>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
        ChainBot fits naturally into modern CLI-first workflows, from coding copilots to orchestration surfaces and open agent runtimes.
      </p>
    </div>

    <BrandMarquee items={items} />
  </div>
</section>
