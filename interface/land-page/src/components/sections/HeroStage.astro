---
import type { SiteContent } from "@/content/site";

interface Props {
  content: SiteContent;
  docsUrl: string;
}

const { content, docsUrl } = Astro.props;
---

<section class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-start gap-16 px-6 pb-24 pt-16 lg:grid-cols-12 lg:gap-8">
  <div class="flex min-w-0 flex-col items-start lg:col-span-7 lg:pr-8">
    <div class="type-eyebrow mb-8 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3 py-1.5 text-primary-strong">
      <svg aria-hidden="true" class="size-3 opacity-70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M22 11.08V12A10 10 0 1 1 12.07 2.86"></path>
        <path d="m22 4-10 10.01-3-3"></path>
      </svg>
      {content.hero.badge}
    </div>

    <h1 class="max-w-4xl text-balance font-display text-[clamp(3rem,8vw,4.5rem)] leading-[1.04] tracking-tight text-foreground">
      {content.hero.title}
    </h1>

    <p class="mb-10 mt-6 max-w-[35rem] text-pretty text-[1.125rem] font-normal leading-[1.72] text-muted-foreground">
      {content.hero.description}
    </p>

  </div>

  <div class="relative mt-8 lg:col-span-5 lg:mt-0">
    <div class="relative rounded-[2rem] border border-white/10 bg-foreground p-6 shadow-[0_18px_48px_rgba(17,19,21,0.18)] sm:p-8">
      <div class="mb-8 text-center">
        <div class="type-eyebrow mb-3 text-white/65">{content.install.eyebrow}</div>
        <h2 class="font-display text-[2rem] tracking-[-0.02em] text-white">{content.install.title}</h2>
        <p class="type-caption mt-2 text-white/70">{content.install.description}</p>
      </div>

      <div class="group flex flex-col gap-4 rounded-xl border border-white/10 bg-black/60 p-4 transition-colors hover:border-primary/50 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-start gap-3">
          <span class="type-command text-primary">$</span>
          <code class="type-command command-scroll min-w-0 whitespace-nowrap text-white/90">{content.install.primaryCommand}</code>
        </div>
        <button aria-label={content.install.copyLabel} class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center self-end rounded-lg text-white/65 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 sm:self-auto" data-copy-text={content.install.primaryCommand} type="button">
          <svg aria-hidden="true" class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect height="13" rx="2" ry="2" width="13" x="9" y="9"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>

      <div class="mt-10">
        <div class="type-eyebrow mb-4 pl-2 text-white/65">{content.install.nextStepsLabel}</div>
        <div class="space-y-1">
          {content.install.nextSteps.map((step) => (
            <div class="group flex min-w-0 flex-col gap-2 rounded-lg px-3 py-2 transition-colors hover:bg-white/5 sm:flex-row sm:items-center sm:gap-4">
              <span class="size-1.5 rounded-full bg-white/25 transition-colors group-hover:bg-primary"></span>
              <code class="type-command command-scroll min-w-0 flex-1 whitespace-nowrap text-white/80">{step.command}</code>
              <span class="type-caption text-white/65 sm:text-right">{step.description}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-8 border-t border-white/10 pt-6 text-center">
        <a class="inline-flex min-h-11 items-center justify-center gap-2 text-[0.9375rem] font-medium tracking-[0.01em] text-white/70 transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50" href={docsUrl} rel="noreferrer" target="_blank">
          {content.install.docsLabel}
          <svg aria-hidden="true" class="size-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
