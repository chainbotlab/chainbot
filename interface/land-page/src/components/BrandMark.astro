---
interface Props {
  compact?: boolean;
  homeHref?: string;
  name?: string;
  eyebrow?: string;
}

const {
  compact = false,
  homeHref = "https://chainbot.dev",
  name = "ChainBot CLI",
  eyebrow = "Developer Tooling",
} = Astro.props;
---

<a class="inline-flex items-center gap-3 text-foreground" href={homeHref}>
  <picture>
    <source srcset="/chainbot-logo.webp" type="image/webp" />
    <img
      alt="ChainBot logo"
      class:list={[
        "shrink-0 rounded-[1rem] bg-surface/90 object-contain ring-1 ring-border/60",
        compact ? "size-10" : "size-12",
      ]}
      decoding="async"
      fetchpriority="high"
      height={compact ? 40 : 48}
      loading="eager"
      src="/chainbot-logo.png"
      width={compact ? 40 : 48}
    />
  </picture>
  <span class="flex min-w-0 flex-col leading-none">
    <span class:list={["font-display tracking-tight text-foreground", compact ? "text-[1.3125rem]" : "text-[1.625rem]"]}>{name}</span>
    <span class="type-eyebrow mt-1 text-muted-foreground">{eyebrow}</span>
  </span>
</a>
