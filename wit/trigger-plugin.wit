package chainbot:trigger-plugin@0.1.0;

/// Transport-only host callbacks used by long-lived trigger guests.
interface trigger-host {
    /// Successful callback result after host durable staging.
    enum host-push-success {
        durable-ack,
    }

    /// Typed host outcomes that guide retry or terminal stop behavior.
    enum host-push-error {
        backpressure,
        lease-lost,
        shutting-down,
    }

    /// Guest-driven push callback.
    ///
    /// `event-bytes` is a transport envelope; business schema remains in
    /// plugin manifests and runtime contracts.
    push-trigger-event: func(event-bytes: list<u8>) -> result<host-push-success, host-push-error>;
}

/// Guest session entrypoint for persistent trigger runtimes.
interface trigger-guest {
    run-session: func();
}

world trigger-plugin {
    import trigger-host;
    export trigger-guest;
}
